# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database Configuration
DATABASE_URL=bot_user:bot_password@tcp(mysql:3306)/dating_bot?charset=utf8mb4&parseTime=True&loc=Local

# MySQL Configuration
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=dating_bot
MYSQL_USER=bot_user
MYSQL_PASSWORD=bot_password

# Redis Configuration
REDIS_URL=redis:6379
REDIS_PASSWORD=

# Performance Configuration
MAX_DB_CONNECTIONS=100
RATE_LIMIT=10
BURST_LIMIT=20
WORKER_COUNT=10